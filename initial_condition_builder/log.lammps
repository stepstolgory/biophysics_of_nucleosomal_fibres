######
## Add attractions
######

# switch on attraction between proteins and DNA so they wrap up
pair_coeff      1 5*22 morse ${wrapEuniform} 10.0 0.0 0.7
pair_coeff      1 5*22 morse 10 10.0 0.0 0.7
run 500000  # total so far 850000
