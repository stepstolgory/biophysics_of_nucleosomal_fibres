## Now do the main simulation

undump dum1 # switch off dump command
reset_timestep 0 # reset clock to 0
# new dump command - less frequently
dump dum1 all custom 10000 dump_main.nucleosomes id type x y z ix iy iz c_quat[1] c_quat[2] c_quat[3] c_quat[4]

run 10000000
